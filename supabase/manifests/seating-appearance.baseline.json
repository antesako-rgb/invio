      "constraints": [
        {
          "name": "seating_elements_dimensions_check",
          "deferred": false,
          "validated": true,
          "deferrable": false,
          "definition": "CHECK ((((kind = 'dance_floor'::text) AND ((width_cm >= 200) AND (width_cm <= 2000)) AND ((height_cm >= 200) AND (height_cm <= 2000))) OR ((kind = 'stage'::text) AND ((width_cm >= 200) AND (width_cm <= 2000)) AND ((height_cm >= 120) AND (height_cm <= 1200))) OR ((kind = 'dj_booth'::text) AND ((width_cm >= 120) AND (width_cm <= 500)) AND ((height_cm >= 60) AND (height_cm <= 300)))))"
        },
        {
          "name": "seating_elements_name_check",
          "deferred": false,
          "validated": true,
          "deferrable": false,
          "definition": "CHECK (((char_length(TRIM(BOTH FROM name)) >= 1) AND (char_length(TRIM(BOTH FROM name)) <= 150)))"
        },
        {
          "name": "seating_elements_order_check",
          "deferred": false,
          "validated": true,
          "deferrable": false,
          "definition": "CHECK (((z_index >= 0) AND (z_index <= 10000)))"
        },
        {
          "name": "seating_elements_pk",
          "deferred": false,
          "validated": true,
          "deferrable": false,
          "definition": "PRIMARY KEY (id)"
        },
        {
          "name": "seating_elements_plan_fk",
          "deferred": false,
          "validated": true,
          "deferrable": false,
          "definition": "FOREIGN KEY (project_id, plan_id) REFERENCES seating_plans(project_id, id) ON DELETE CASCADE"
        },
        {
          "name": "seating_elements_position_check",
          "deferred": false,
          "validated": true,
          "deferrable": false,
          "definition": "CHECK ((((x_cm >= 0) AND (x_cm <= 100000)) AND ((y_cm >= 0) AND (y_cm <= 100000))))"
        },
        {
          "name": "seating_elements_rotation_check",
          "deferred": false,
          "validated": true,
          "deferrable": false,
          "definition": "CHECK (((rotation_deg >= 0) AND (rotation_deg <= 359)))"
        }
